<?xml version="1.0" encoding="UTF-8"?>
<controls:PersianInputBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiPersianToolkit.Controls.EditorView"
             xmlns:controls="clr-namespace:MauiPersianToolkit.Controls"
             x:DataType="controls:EditorView"
             x:Name="editorView">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto" RowSpacing="0" ColumnSpacing="6">
        <Rectangle Aspect="Fill" RadiusX="5" RadiusY="5" StrokeThickness="1"
                   Fill="{AppThemeBinding Light={StaticResource PdtInputFillLight}, Dark={StaticResource PdtInputFillDark}}"
                   x:Name="outline" StrokeLineJoin="Round" Grid.Row="1" Grid.ColumnSpan="2"
                   Stroke="{AppThemeBinding Light={StaticResource PdtOutlineLight}, Dark={StaticResource PdtOutlineDark}}"
                   Margin="0,8,0,0" VerticalOptions="Fill" HorizontalOptions="Fill"/>

        <Label Grid.Row="0" Grid.Column="0"
               Text="{Binding Title, Source={x:Reference editorView}}"
               TextColor="{Binding PlaceHolderColor, Source={x:Reference editorView}}"
               FontFamily="IranianSans" FontAttributes="Bold" FontSize="13"
               VerticalOptions="Center" Margin="4,0,0,0"/>

        <Label Grid.Row="0" Grid.Column="1"
               Text="{Binding Icon, Source={x:Reference editorView}}"
               TextColor="{Binding PlaceHolderColor, Source={x:Reference editorView}}"
               FontFamily="FontAwesome" FontSize="14"
               VerticalOptions="Center" HorizontalOptions="End"
               Margin="0,0,4,0">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding Icon, Source={x:Reference editorView}}"
                             Value="">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <Editor FontAutoScalingEnabled="True"
                Placeholder="{Binding PlaceHolder, Source={x:Reference editorView}}"
                PlaceholderColor="{Binding PlaceHolderColor, Source={x:Reference editorView}}"
                Grid.Row="1" Grid.ColumnSpan="2"
                Text="{Binding Text, Source={x:Reference editorView}}"
                AutoSize="TextChanges"
                TextColor="{Binding TextColor, Source={x:Reference editorView}}"
                Keyboard="{Binding Keyboard, Source={x:Reference editorView}}"
                FontSize="Small" Margin="7,12,7,4"
                BackgroundColor="Transparent"
                x:Name="txtEditor" FontFamily="IranianSans" VerticalOptions="Fill"
                MinimumHeightRequest="100"/>

        <Label Text="{Binding ErrorMessage, Source={x:Reference editorView}}"
               Grid.Row="2" Grid.ColumnSpan="2"
               HorizontalOptions="End" VerticalTextAlignment="Center"
               x:Name="lblMessage" InputTransparent="True"
               Margin="0,2,4,0"
               IsVisible="{Binding IsValid, Source={x:Reference editorView}}"/>
    </Grid>
</controls:PersianInputBase>
